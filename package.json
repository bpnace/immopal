{
  "name": "immo-pal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('.next',{ recursive:true, force:true })\"",
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/write-htaccess.mjs",
    "export": "next build",
    "postexport": "node scripts/write-htaccess.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "security:check": "node scripts/security-checks.mjs",
    "test": "npm run lint -- --max-warnings=0 && npm run typecheck && npm run security:check"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dompurify": "^3.4.2",
    "framer-motion": "^12.38.0",
    "graphql": "^16.14.0",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "baseline-browser-mapping": "^2.10.37",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "next": {
      "postcss": "$postcss"
    }
  }
}
